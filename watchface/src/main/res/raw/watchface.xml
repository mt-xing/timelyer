        <Font family="SYNC_TO_DEVICE" size="96" weight="BOLD" slant="NORMAL" color="#ffffffff"/>
      </TimeText>
      <!-- Ambient mode version - thinner weight -->
      <TimeText format="hh:mm" hourFormat="24" align="CENTER" x="0" y="100" width="300" height="100" alpha="0">
        <!-- Specifying the watch's default family by using SYNC_TO_DEVICE -->
        <Variant mode="AMBIENT" target="alpha" value="255"/>
        <Font family="SYNC_TO_DEVICE" size="96" weight="THIN" slant="NORMAL" color="#ffffffff"/>
