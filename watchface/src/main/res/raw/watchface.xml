<?xml version="1.0"?>
<WatchFace width="450" height="450">
  <Metadata key="CLOCK_TYPE" value="DIGITAL"/>
  <Metadata key="PREVIEW_TIME" value="10:08:32"/>
  <Scene backgroundColor="#ff000000">
    <DigitalClock x="120" y="0" width="300" height="450">
      <TimeText format="hh:mm" hourFormat="24" align="CENTER" x="0" y="100" width="300" height="100" alpha="255">
        <Variant mode="AMBIENT" target="alpha" value="0"/>
        <!-- Specifying the watch's default font-family by using SYNC_TO_DEVICE instead of a named family -->
        <Font family="SYNC_TO_DEVICE" size="96" weight="BOLD" slant="NORMAL" color="#ffffffff"/>
      </TimeText>
      <!-- Ambient mode version - thinner weight -->
      <TimeText format="hh:mm" hourFormat="24" align="CENTER" x="0" y="100" width="300" height="100" alpha="0">
        <!-- Specifying the watch's default family by using SYNC_TO_DEVICE -->
        <Variant mode="AMBIENT" target="alpha" value="255"/>
        <Font family="SYNC_TO_DEVICE" size="96" weight="THIN" slant="NORMAL" color="#ffffffff"/>
      </TimeText>
    </DigitalClock>

    <Group x="150" y="200" width="150" height="32" name="step">
      <PartText x="0" y="0" width="150" height="32">
        <Text align="START">
          <Font family="SYNC_TO_DEVICE" size="24" color="#ffffffff">
            <Template>%s %d
              <Parameter expression="👣" />
              <Parameter expression="[STEP_COUNT]" />
            </Template>
          </Font>
        </Text>
      </PartText>
    </Group>

    <Group x="250" y="200" width="100" height="32" name="heart">
